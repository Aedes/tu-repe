{
  "name": "tu-repe",
  "version": "1.0.0",
  "main": "build/src/server.js",
  "scripts": {
    "start": "node build/src/server.js",
    "start:worker": "node build/src/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node-dev --respawn src/server.ts",
    "dev:worker": "ts-node-dev --respawn src/worker.ts",
    "dev-test": "NODE_ENV=test ts-node-dev src/server.ts",
    "test": "NODE_ENV=test jest --runInBand --testTimeout=30000 --testPathIgnorePatterns=external",
    "test:integration": "NODE_ENV=test jest --runInBand --testTimeout=30000 tests/integration",
    "lint": "tsc --noEmit",
    "format:check": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "migrate": "ts-node --transpile-only database/migrate.ts",
    "migrate:dev": "ts-node --transpile-only database/migrate.ts",
    "migrate:test": "NODE_ENV=test ts-node --transpile-only database/migrate.ts",
    "create-admin": "ts-node --transpile-only scripts/create-admin.ts",
    "retention:dry-run": "ts-node --transpile-only scripts/retention-dry-run.ts",
    "clear-db:test": "NODE_ENV=test ts-node --transpile-only src/utils/clearDatabase.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Tu Repe API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/lib-storage": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^4.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.2.1",
    "otplib": "^12.0.1",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
