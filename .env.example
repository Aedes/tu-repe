# Copiá este archivo a .env y completá valores reales.
# Nunca reutilices secretos entre entornos. Todos los valores de producción
# deben ser aleatorios, independientes y almacenados fuera de Git.

# development | test | production
NODE_ENV=development
PORT=5001
TZ=UTC

# Origen exacto del frontend (CORS, CSRF Origin, cookies Secure en producción)
FRONTEND_ORIGIN=http://localhost:5173

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tu_repe_db
MYSQL_USER=tu_repe
MYSQL_PASSWORD=replace_with_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_long_random_root_password

# JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=replace_with_32_plus_random_chars
JWT_ISSUER=tu-repe
JWT_AUDIENCE=tu-repe-web
JWT_ADMIN_TTL=2h
JWT_USER_TTL=7d

# Backblaze B2 (S3-compatible). El bucket debe ser privado.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=tu-repe-videos
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MediaMTX interno. En Docker usar rtsp://mediamtx:8554
MEDIA_SERVER_RTSP_BASE_URL=rtsp://127.0.0.1:8554
MEDIA_AUTH_SECRET=replace_with_long_random_webhook_secret

# Cloudflare Turnstile (secret sólo backend)
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Video
VIDEO_RETENTION_HOURS=72
VIDEO_CHUNK_DURATION_SECONDS=900
# copy: guarda el video de la cámara sin recodificar. transcode: vuelve a codificar con libx264.
VIDEO_RECORDING_MODE=copy
VIDEO_DIR=/var/videos
UPLOAD_DIR=./uploads
STABILITY_THRESHOLD_MS=10000
APPOINTMENT_MERGE_ENABLED=true
APPOINTMENT_MERGE_MAX_ATTEMPTS=3
APPOINTMENT_MERGE_FFMPEG_TIMEOUT_MS=300000
APPOINTMENT_MERGE_WORKER_INTERVAL_MS=5000
APPOINTMENT_MERGE_COVERAGE_TOLERANCE_MS=10000
APPOINTMENT_MERGE_DISK_MARGIN_BYTES=536870912
APPOINTMENT_MERGE_URL_EXTRA_SECONDS=1800
APPOINTMENT_MERGE_LOCK_TIMEOUT_MINUTES=20

# Clips generados en el servidor
CLIP_MAX_DURATION_MS=30000
CLIP_MIN_DURATION_MS=1000
CLIP_FFMPEG_TIMEOUT_MS=120000
CLIP_MAX_WAITERS=3
CLIP_DISK_MARGIN_BYTES=67108864
CLIP_COVERAGE_TOLERANCE_MS=10000

# Cookies / proxy
COOKIE_SECURE=false
TRUST_PROXY=1
